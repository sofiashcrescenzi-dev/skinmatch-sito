{
  // Il sito statico (out/, generato da `next build` con output: 'export') più un Worker piccolo
  // (worker/index.js) che gira solo su /api/* e /admin*: conteggi senza dati personali, admin
  // protetto da Cloudflare Access. Tutto il resto lo servono gli asset, come prima.
  "name": "skinmatch-sito",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "account_id": "7fca2fe0c2f889d868a70e712cdcef85",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /pagina -> serve out/pagina.html (URL puliti senza .html)
    "html_handling": "auto-trailing-slash",
    // pagina non trovata -> il Worker: un prodotto uscito dal catalogo rinvia (301) alla sua categoria,
    // il resto riceve out/404.html con lo stato 404 (worker/index.js, «pagine sparite mai 404»)
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "skinmatch-dati", "database_id": "b261e5c4-e4a2-4961-b573-36d9f8861312" }
  ],
  "vars": {
    // chi può aprire l'admin (oltre a passare da Cloudflare Access)
    "ADMIN_EMAILS": "hello@agoranomos.cloud,sofiashcrescenzi@gmail.com",
    // Chiuso il 16/10 su richiesta di Sofia: finché Access non è attivo si entra solo con il link con la chiave
    // (segreto ADMIN_CHIAVE); poi resta solo Access. Non rimettere "si": l'admin aperto è modificabile da chiunque.
    "ADMIN_APERTO": "no",
    // Cloudflare Access attivo dal 16/10: team fragrant-dawn-e18a (fragrant-dawn-e18a.cloudflareaccess.com),
    // applicazione «Admin Skinmatch» su skinmatch.it/admin e skinmatch.it/api/admin, codice via email.
    "ACCESS_TEAM": "fragrant-dawn-e18a",
    "ACCESS_AUD": "f21555928e4812dd6b7791cc40a9bc23949ff25ea86e1859ea6e2d47f28b0d19"
  },
  "observability": { "enabled": true }
}
